{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Bee Diversity Does Not Always Match Managed Hive Activity",
    "subtitle": "State rankings based on recorded bee taxa and managed hives",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 620,
  "height": 360,

  "data": {
    "values": [
      {"state": "Queensland", "measure": "Recorded bee diversity", "rank": 1},
      {"state": "Queensland", "measure": "Managed hives", "rank": 3},

      {"state": "Western Australia", "measure": "Recorded bee diversity", "rank": 2},
      {"state": "Western Australia", "measure": "Managed hives", "rank": 5},

      {"state": "New South Wales", "measure": "Recorded bee diversity", "rank": 3},
