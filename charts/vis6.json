          }
        },

        "color": {
          "field": "state",
          "type": "nominal",
          "title": "State",
          "scale": {
            "domain": [
              "Queensland",
              "Western Australia",
              "New South Wales",
              "Victoria",
              "South Australia",
              "Tasmania"
            ],
            "range": [
              "#F28E2B",
              "#EDC948",
              "#4E79A7",
              "#59A14F",
              "#E15759",
              "#76B7B2"
            ]
          },
          "legend": {
            "orient": "right",
