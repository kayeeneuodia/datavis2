      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120
      },

      "encoding": {
        "x": {
          "field": "measure",
          "type": "nominal",
          "sort": [
            "Recorded bee diversity",
            "Managed hives"
          ]
        },

        "y": {
          "field": "rank",
