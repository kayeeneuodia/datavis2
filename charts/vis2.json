{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Where Have Bees Been Recorded in Australia?",
    "subtitle": "A sample of Atlas of Living Australia bee occurrence records",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 470,
  "height": 360,

  "projection": {
  "type": "equalEarth",
  "scale": 850
},
  
  "layer": [
    {
       "data": {
    "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_map_points_sample.csv",
        "format": {
          "type": "csv",
          "parse": {
            "decimalLongitude": "number",
            "decimalLatitude": "number",
            "year": "number"
          }
        }
      },

      "mark": {
      "type": "circle",
      "size": 14,
      "opacity": 0.45
      },

      "encoding": {
        "longitude": {
          "field": "decimalLongitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "decimalLatitude",
          "type": "quantitative"
        },

        "color": {
          "field": "family",
          "type": "nominal",
          "title": "Bee family"
        },

        "tooltip": [
          {
            "field": "scientificName",
            "type": "nominal",
            "title": "Scientific name"
          },
          {
            "field": "family",
            "type": "nominal",
            "title": "Bee family"
          },
          {
            "field": "stateProvince",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          }
        ]
      }
    }
  ],

  "resolve": {
    "scale": {
      "color": "independent"
    }
  },

  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
