{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Where Have Bees Been Recorded in Australia?",
    "subtitle": "A sample of Atlas of Living Australia bee occurrence records",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 800,
  "height": 520,

  "projection": {
    "type": "equalEarth"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",

        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#ECE8DE",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_map_points_sample.csv",

        "format": {
          "type": "csv",

          "parse": {
            "decimalLatitude": "number",
            "decimalLongitude": "number",
            "year": "number",
            "month": "number"
          }
        }
      },

      "transform": [
        {
          "filter": "isValid(datum.decimalLatitude) && isValid(datum.decimalLongitude)"
        }
      ],

      "mark": {
        "type": "circle",
        "size": 42,
        "opacity": 0.72,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.45
      },

      "encoding": {
        "longitude": {
          "field": "decimalLongitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "decimalLatitude",
          "type": "quantitative"
        },

        "color": {
          "field": "family",
          "type": "nominal",
          "title": "Bee family",

          "scale": {
            "domain": [
              "Apidae",
              "Colletidae",
              "Halictidae",
              "Megachilidae",
              "Stenotritidae"
            ],

            "range": [
              "#32689A",
              "#E67E22",
              "#D94F4F",
              "#49A6A0",
              "#4F8B45"
            ]
          },

          "legend": {
            "orient": "right",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "symbolSize": 100
          }
        },

        "tooltip": [
          {
            "field": "scientificName",
            "type": "nominal",
            "title": "Scientific name"
          },

          {
            "field": "vernacularName",
            "type": "nominal",
            "title": "Common name"
          },

          {
            "field": "family",
            "type": "nominal",
            "title": "Bee family"
          },

          {
            "field": "stateProvince",
            "type": "nominal",
            "title": "State / Territory"
          },

          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
