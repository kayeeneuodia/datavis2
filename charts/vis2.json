{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Where Have Bees Been Recorded in Australia?",
    "subtitle": "A sample of Atlas of Living Australia bee occurrence records",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 760,
  "height": 500,

  "projection": {
    "type": "equalEarth"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 1.1
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_map_points_sample.csv",
        "format": {
          "type": "csv",
          "parse": {
            "decimalLongitude": "number",
            "decimalLatitude": "number",
            "year": "number"
          }
        }
      },

      "mark": {
        "type": "circle",
        "size": 34,
        "opacity": 0.7,
        "stroke": "white",
        "strokeWidth": 0.35
      },

      "encoding": {
        "longitude": {
          "field": "decimalLongitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "decimalLatitude",
          "type": "quantitative"
        },

        "color": {
          "field": "family",
          "type": "nominal",
          "title": "Bee family",
          "scale": {
            "domain": [
              "Apidae",
              "Colletidae",
              "Halictidae",
              "Megachilidae",
              "Stenotritidae"
            ],
            "range": [
              "#4E79A7",
              "#F28E2B",
              "#E15759",
              "#76B7B2",
              "#59A14F"
            ]
          },
          "legend": {
            "orient": "right",
            "labelFontSize": 12,
            "titleFontSize": 12
          }
        },

        "tooltip": [
          {
            "field": "scientificName",
            "type": "nominal",
            "title": "Scientific name"
          },
          {
            "field": "family",
            "type": "nominal",
            "title": "Bee family"
          },
          {
            "field": "stateProvince",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          }
        ]
      }
    }
  ],

  "resolve": {
    "scale": {
      "color": "independent"
    }
  },

  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
