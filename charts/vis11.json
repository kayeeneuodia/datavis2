{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Who Are Australia's Registered Beekeepers?",
    "subtitle": "Each square represents approximately 1% of registered beekeepers",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "spacing": 36,

  "hconcat": [
    {
      "width": 430,
      "height": 300,

      "data": {
        "sequence": {
          "start": 1,
          "stop": 101,
          "as": "square"
        }
      },

      "transform": [
        {
          "calculate": "datum.square <= 6 ? 'Commercial' : 'Recreational'",
          "as": "beekeeperType"
        },

        {
          "calculate": "(datum.square - 1) % 10",
          "as": "column"
        },

        {
          "calculate": "floor((datum.square - 1) / 10)",
          "as": "row"
        },

        {
          "calculate": "datum.beekeeperType == 'Commercial' ? 'Approximately 6%' : 'Approximately 94%'",
          "as": "share"
        }
      ],

      "mark": {
        "type": "rect",
        "cornerRadius": 4,
        "stroke": "white",
        "strokeWidth": 1.5
      },

      "encoding": {
        "x": {
          "field": "column",
          "type": "ordinal",
          "axis": null
        },

        "y": {
          "field": "row",
          "type": "ordinal",
          "sort": "descending",
          "axis": null
        },

        "color": {
          "field": "beekeeperType",
          "type": "nominal",
          "legend": null,

          "scale": {
            "domain": [
              "Commercial",
              "Recreational"
            ],

            "range": [
              "#E15759",
              "#F2C94C"
            ]
          }
        },

        "tooltip": [
          {
            "field": "beekeeperType",
            "type": "nominal",
            "title": "Beekeeper type"
          },

          {
            "field": "share",
            "type": "nominal",
            "title": "Squares represent"
          }
        ]
      }
    },

    {
      "width": 190,
      "height": 300,

      "data": {
        "values": [
          {
            "type": "Recreational",
            "percentage": "93.7%",
            "count": "27,822 beekeepers",
            "y": 95
          },

          {
            "type": "Commercial",
            "percentage": "6.3%",
            "count": "1,868 beekeepers",
            "y": 215
          }
        ]
      },

      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 25,
            "fontWeight": "bold"
          },

          "encoding": {
            "x": {
              "value": 5
            },

            "y": {
              "field": "y",
              "type": "quantitative",
              "scale": {
                "domain": [300, 0]
              },
              "axis": null
            },

            "text": {
              "field": "percentage"
            },

            "color": {
              "field": "type",
              "type": "nominal",
              "legend": null,

              "scale": {
                "domain": [
                  "Commercial",
                  "Recreational"
                ],

                "range": [
                  "#E15759",
                  "#C99A12"
                ]
              }
            }
          }
        },

        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#333"
          },

          "encoding": {
            "x": {
              "value": 5
            },

            "y": {
              "field": "y",
              "type": "quantitative",
              "scale": {
                "domain": [300, 0]
              },
              "axis": null
            },

            "yOffset": {
              "value": 24
            },

            "text": {
              "field": "type"
            }
          }
        },

        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 12,
            "color": "#666"
          },

          "encoding": {
            "x": {
              "value": 5
            },

            "y": {
              "field": "y",
              "type": "quantitative",
              "scale": {
                "domain": [300, 0]
              },
              "axis": null
            },

            "yOffset": {
              "value": 44
            },

            "text": {
              "field": "count"
            }
          }
        }
      ]
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}
