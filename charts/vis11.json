{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Who Are Australia's Registered Beekeepers?",
    "subtitle": "About 94% are recreational and 6% are commercial",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 500,
  "height": 300,

  "data": {
    "sequence": {
      "start": 1,
      "stop": 101,
      "step": 1
    }
  },

  "transform": [
    {
      "calculate": "(datum.data - 1) % 10",
      "as": "column"
    },
    {
      "calculate": "floor((datum.data - 1) / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.data <= 6 ? 'Commercial' : 'Recreational'",
      "as": "beekeeperType"
    },
    {
      "calculate": "datum.beekeeperType == 'Commercial' ? 1868 : 27822",
      "as": "beekeeperCount"
    },
    {
      "calculate": "datum.beekeeperType == 'Commercial' ? 6.3 : 93.7",
      "as": "percentage"
    }
  ],

  "mark": {
    "type": "square",
    "filled": true,
    "size": 700
  },

  "encoding": {
    "x": {
      "field": "column",
      "type": "ordinal",
      "axis": null
    },

    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "sort": "descending"
    },

    "color": {
      "field": "beekeeperType",
      "type": "nominal",
      "title": "Beekeeper type",
      "scale": {
        "domain": [
          "Commercial",
          "Recreational"
        ],
        "range": [
          "#E15759",
          "#F2C94C"
        ]
      },
      "legend": {
        "orient": "right",
        "labelFontSize": 12,
        "titleFontSize": 12
      }
    },

    "tooltip": [
      {
        "field": "beekeeperType",
        "type": "nominal",
        "title": "Beekeeper type"
      },
      {
        "field": "beekeeperCount",
        "type": "quantitative",
        "title": "Registered beekeepers",
        "format": ","
      },
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Share (%)",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}
