{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Who Are Australia's Registered Beekeepers?",
    "subtitle": "Each square represents approximately 1% of registered beekeepers",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 520,
  "height": 340,

  "data": {
    "sequence": {
      "start": 0,
      "stop": 100,
      "step": 1,
      "as": "id"
    }
  },

  "transform": [
    {
      "calculate": "datum.id % 10",
      "as": "column"
    },
    {
      "calculate": "floor(datum.id / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.id < 6 ? 'Commercial' : 'Recreational'",
      "as": "beekeeperType"
    },
    {
      "calculate": "datum.beekeeperType == 'Commercial' ? 1868 : 27822",
      "as": "beekeeperCount"
    },
    {
      "calculate": "datum.beekeeperType == 'Commercial' ? 6.3 : 93.7",
      "as": "percentage"
    }
  ],

  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "white",
    "strokeWidth": 2
  },

  "encoding": {
    "x": {
      "field": "column",
      "type": "ordinal",
      "axis": null
    },

    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "sort": "descending"
    },

    "color": {
      "field": "beekeeperType",
      "type": "nominal",
      "title": "Beekeeper type",
      "scale": {
        "domain": [
          "Commercial",
          "Recreational"
        ],
        "range": [
          "#E15759",
          "#F2C94C"
        ]
      },
      "legend": {
        "orient": "right",
        "labelFontSize": 12,
        "titleFontSize": 12
      }
    },

    "tooltip": [
      {
        "field": "beekeeperType",
        "type": "nominal",
        "title": "Beekeeper type"
      },
      {
        "field": "beekeeperCount",
        "type": "quantitative",
        "title": "Registered beekeepers",
        "format": ","
      },
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Share",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}
