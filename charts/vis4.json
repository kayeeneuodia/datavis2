{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "When Are Different Bee Families Most Commonly Recorded?",
    "subtitle": "Darker cells indicate more recorded bee occurrences",
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 11,
    "subtitleColor": "#666"
  },

  "width": 430,
  "height": 260,

  "data": {
    "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_month_family_summary.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month": "number",
        "records": "number",
        "uniqueSpecies": "number"
      }
    }
  },

  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1
  },

  "encoding": {
    "x": {
      "field": "monthName",
      "type": "ordinal",
      "title": "Month",
      "sort": [
        "Jan", "Feb", "Mar", "Apr", "May", "Jun",
        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
      ],
      "axis": {
        "labelFontSize": 10,
        "titleFontSize": 11,
        "labelAngle": 0
      }
    },

    "y": {
      "field": "family",
      "type": "nominal",
      "title": "Bee family",
      "axis": {
        "labelFontSize": 10,
        "titleFontSize": 11
      }
    },

    "color": {
      "field": "records",
      "type": "quantitative",
      "title": "Occurrence records",
      "scale": {
        "scheme": "orangered"
      },
      "legend": {
        "labelFontSize": 10,
        "titleFontSize": 10
      }
    },

    "tooltip": [
      {
        "field": "family",
        "type": "nominal",
        "title": "Bee family"
      },
      {
        "field": "monthName",
        "type": "ordinal",
        "title": "Month"
      },
      {
        "field": "records",
        "type": "quantitative",
        "title": "Occurrence records",
        "format": ","
      },
      {
        "field": "uniqueSpecies",
        "type": "quantitative",
        "title": "Unique recorded taxa",
        "format": ","
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}
