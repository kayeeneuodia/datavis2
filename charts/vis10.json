{
  "$schema": "https://vega.github.io/schema/vega/v6.json",

  "width": 820,
  "height": 360,

  "padding": {
    "left": 30,
    "right": 30,
    "top": 45,
    "bottom": 15
  },

  "title": {
    "text": "How Are Bee Records Distributed Across States and Families?",
    "subtitle": "Thicker flows represent more ALA bee occurrence records",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "signals": [
    {
      "name": "hoverState",
      "value": null,
      "on": [
        {
          "events": "@flowPath:mouseover",
          "update": "datum.stateProvince"
        },
        {
          "events": "@flowPath:mouseout",
          "update": "null"
        }
      ]
    },
    {
      "name": "hoverFamily",
      "value": null,
      "on": [
        {
          "events": "@flowPath:mouseover",
          "update": "datum.family"
        },
        {
          "events": "@flowPath:mouseout",
          "update": "null"
        }
      ]
    }
  ],

  "data": [
    {
      "name": "raw",
      "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_state_family_summary.csv",
      "format": {
        "type": "csv",
        "parse": {
          "records": "number",
          "uniqueSpecies": "number"
        }
      }
    },

    {
      "name": "states",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["stateProvince"],
          "fields": ["records"],
          "ops": ["sum"],
          "as": ["total"]
        },
        {
          "type": "collect",
          "sort": {
            "field": "total",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["index"]
        },
        {
          "type": "formula",
          "expr": "55 + (datum.index - 1) * 38",
          "as": "y"
        }
      ]
    },

    {
      "name": "families",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["family"],
          "fields": ["records"],
          "ops": ["sum"],
          "as": ["total"]
        },
        {
          "type": "formula",
          "expr": "datum.family == 'Apidae' ? 1 : datum.family == 'Colletidae' ? 2 : datum.family == 'Halictidae' ? 3 : datum.family == 'Megachilidae' ? 4 : 5",
          "as": "familyOrder"
        },
        {
          "type": "collect",
          "sort": {
            "field": "familyOrder",
            "order": "ascending"
          }
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["index"]
        },
        {
          "type": "formula",
          "expr": "78 + (datum.index - 1) * 55",
          "as": "y"
        }
      ]
    },

    {
      "name": "links",
      "source": "raw",
      "transform": [
        {
          "type": "lookup",
          "from": "states",
          "key": "stateProvince",
          "fields": ["stateProvince"],
          "values": ["y"],
          "as": ["sourceY"]
        },
        {
          "type": "lookup",
          "from": "families",
          "key": "family",
          "fields": ["family"],
          "values": ["y"],
          "as": ["targetY"]
        },
        {
          "type": "formula",
          "expr": "190",
          "as": "sourceX"
        },
        {
          "type": "formula",
          "expr": "width - 145",
          "as": "targetX"
        },
        {
          "type": "formula",
          "expr": "(datum.sourceX + datum.targetX) / 2",
          "as": "midX"
        },
        {
          "type": "formula",
          "expr": "'M' + datum.sourceX + ',' + datum.sourceY + ' C' + datum.midX + ',' + datum.sourceY + ' ' + datum.midX + ',' + datum.targetY + ' ' + datum.targetX + ',' + datum.targetY",
          "as": "path"
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "linkWidth",
      "type": "sqrt",
      "domain": {
        "data": "links",
        "field": "records"
      },
      "range": [1.2, 16]
    },

    {
      "name": "familyColor",
      "type": "ordinal",
      "domain": [
        "Apidae",
        "Colletidae",
        "Halictidae",
        "Megachilidae",
        "Stenotritidae"
      ],
      "range": [
        "#4E79A7",
        "#F28E2B",
        "#E15759",
        "#76B7B2",
        "#59A14F"
      ]
    }
  ],

  "marks": [
    {
      "name": "flowPath",
      "type": "path",
      "from": {
        "data": "links"
      },

      "encode": {
        "enter": {
          "path": {
            "field": "path"
          },

          "stroke": {
            "scale": "familyColor",
            "field": "family"
          },

          "strokeWidth": {
            "scale": "linkWidth",
            "field": "records"
          },

          "strokeCap": {
            "value": "round"
          },

          "fill": {
            "value": null
          },

          "tooltip": {
            "signal": "{'State / Territory': datum.stateProvince, 'Bee family': datum.family, 'Occurrence records': format(datum.records, ','), 'Unique recorded taxa': format(datum.uniqueSpecies, ',')}"
          }
        },

        "update": {
          "strokeOpacity": {
            "signal": "hoverState == null ? 0.35 : (datum.stateProvince == hoverState && datum.family == hoverFamily ? 0.95 : 0.08)"
          }
        }
      }
    },

    {
      "type": "symbol",
      "from": {
        "data": "states"
      },

      "encode": {
        "enter": {
          "x": {
            "value": 190
          },

          "y": {
            "field": "y"
          },

          "shape": {
            "value": "square"
          },

          "size": {
            "value": 250
          },

          "fill": {
            "value": "#4A4A4A"
          }
        },

        "update": {
          "opacity": {
            "signal": "hoverState == null || datum.stateProvince == hoverState ? 1 : 0.35"
          }
        }
      }
    },

    {
      "type": "text",
      "from": {
        "data": "states"
      },

      "encode": {
        "enter": {
          "x": {
            "value": 174
          },

          "y": {
            "field": "y"
          },

          "text": {
            "field": "stateProvince"
          },

          "align": {
            "value": "right"
          },

          "baseline": {
            "value": "middle"
          },

          "fontSize": {
            "value": 12
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#333"
          }
        },

        "update": {
          "opacity": {
            "signal": "hoverState == null || datum.stateProvince == hoverState ? 1 : 0.35"
          }
        }
      }
    },

    {
      "type": "symbol",
      "from": {
        "data": "families"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "width - 145"
          },

          "y": {
            "field": "y"
          },

          "shape": {
            "value": "square"
          },

          "size": {
            "value": 250
          },

          "fill": {
            "scale": "familyColor",
            "field": "family"
          }
        },

        "update": {
          "opacity": {
            "signal": "hoverFamily == null || datum.family == hoverFamily ? 1 : 0.35"
          }
        }
      }
    },

    {
      "type": "text",
      "from": {
        "data": "families"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "width - 128"
          },

          "y": {
            "field": "y"
          },

          "text": {
            "field": "family"
          },

          "align": {
            "value": "left"
          },

          "baseline": {
            "value": "middle"
          },

          "fontSize": {
            "value": 12
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#333"
          }
        },

        "update": {
          "opacity": {
            "signal": "hoverFamily == null || datum.family == hoverFamily ? 1 : 0.35"
          }
        }
      }
    },

    {
      "type": "text",

      "encode": {
        "enter": {
          "x": {
            "value": 190
          },

          "y": {
            "value": 18
          },

          "text": {
            "value": "STATE / TERRITORY"
          },

          "align": {
            "value": "center"
          },

          "fontSize": {
            "value": 12
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#444"
          }
        }
      }
    },

    {
      "type": "text",

      "encode": {
        "enter": {
          "x": {
            "signal": "width - 145"
          },

          "y": {
            "value": 18
          },

          "text": {
            "value": "BEE FAMILY"
          },

          "align": {
            "value": "center"
          },

          "fontSize": {
            "value": 12
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#444"
          }
        }
      }
    }
  ]
}
