{
  "$schema": "https://vega.github.io/schema/vega/v6.json",

  "width": 820,
  "height": 360,

  "padding": {
    "left": 25,
    "right": 25,
    "top": 38,
    "bottom": 18
  },

  "title": {
    "text": "How Are Bee Records Distributed Across States and Families?",
    "subtitle": "Thicker flows represent more ALA bee occurrence records",
    "anchor": "start",
    "font": "Inter",
    "subtitleFont": "Inter",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "data": [
    {
      "name": "raw",
      "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_state_family_summary.csv",
      "format": {
        "type": "csv",
        "parse": {
          "records": "number",
          "uniqueSpecies": "number"
        }
      }
    },

    {
      "name": "states",
      "source": "raw",

      "transform": [
        {
          "type": "aggregate",
          "groupby": ["stateProvince"],
          "fields": ["records"],
          "ops": ["sum"],
          "as": ["total"]
        },

        {
          "type": "collect",
          "sort": {
            "field": "total",
            "order": "descending"
          }
        },

        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["index"]
        },

        {
          "type": "formula",
          "expr": "50 + (datum.index - 1) * 38",
          "as": "y"
        }
      ]
    },

    {
      "name": "families",
      "source": "raw",

      "transform": [
        {
          "type": "aggregate",
          "groupby": ["family"],
          "fields": ["records"],
          "ops": ["sum"],
          "as": ["total"]
        },

        {
          "type": "collect",
          "sort": {
            "field": "total",
            "order": "descending"
          }
        },

        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["index"]
        },

        {
          "type": "formula",
          "expr": "78 + (datum.index - 1) * 55",
          "as": "y"
        }
      ]
    },

    {
      "name": "links",
      "source": "raw",

      "transform": [
        {
          "type": "lookup",
          "from": "states",
          "key": "stateProvince",
          "fields": ["stateProvince"],
          "values": ["y"],
          "as": ["sourceY"]
        },

        {
          "type": "lookup",
          "from": "families",
          "key": "family",
          "fields": ["family"],
          "values": ["y"],
          "as": ["targetY"]
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "linkWidth",
      "type": "sqrt",

      "domain": {
        "data": "links",
        "field": "records"
      },

      "range": [1.5, 21]
    },

    {
      "name": "familyColor",
      "type": "ordinal",

      "domain": [
        "Apidae",
        "Colletidae",
        "Halictidae",
        "Megachilidae",
        "Stenotritidae"
      ],

      "range": [
        "#32689A",
        "#E67E22",
        "#D94F4F",
        "#49A6A0",
        "#4F8B45"
      ]
    }
  ],

  "marks": [
    {
      "type": "rule",

      "from": {
        "data": "links"
      },

      "encode": {
        "enter": {
          "x": {
            "value": 195
          },

          "x2": {
            "signal": "width - 135"
          },

          "y": {
            "field": "sourceY"
          },

          "y2": {
            "field": "targetY"
          },

          "stroke": {
            "scale": "familyColor",
            "field": "family"
          },

          "strokeWidth": {
            "scale": "linkWidth",
            "field": "records"
          },

          "strokeOpacity": {
            "value": 0.42
          },

          "tooltip": {
            "signal": "{'State / Territory': datum.stateProvince, 'Bee family': datum.family, 'Occurrence records': format(datum.records, ','), 'Unique recorded taxa': format(datum.uniqueSpecies, ',')}"
          }
        },

        "hover": {
          "strokeOpacity": {
            "value": 0.9
          }
        }
      }
    },

    {
      "type": "symbol",

      "from": {
        "data": "states"
      },

      "encode": {
        "enter": {
          "x": {
            "value": 195
          },

          "y": {
            "field": "y"
          },

          "shape": {
            "value": "square"
          },

          "size": {
            "value": 260
          },

          "fill": {
            "value": "#555555"
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "states"
      },

      "encode": {
        "enter": {
          "x": {
            "value": 179
          },

          "y": {
            "field": "y"
          },

          "text": {
            "field": "stateProvince"
          },

          "align": {
            "value": "right"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {
            "value": 13
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#333333"
          }
        }
      }
    },

    {
      "type": "symbol",

      "from": {
        "data": "families"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "width - 135"
          },

          "y": {
            "field": "y"
          },

          "shape": {
            "value": "square"
          },

          "size": {
            "value": 260
          },

          "fill": {
            "scale": "familyColor",
            "field": "family"
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "families"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "width - 118"
          },

          "y": {
            "field": "y"
          },

          "text": {
            "field": "family"
          },

          "align": {
            "value": "left"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {
            "value": 13
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#333333"
          }
        }
      }
    },

    {
      "type": "text",

      "encode": {
        "enter": {
          "x": {
            "value": 195
          },

          "y": {
            "value": 17
          },

          "text": {
            "value": "STATE / TERRITORY"
          },

          "align": {
            "value": "center"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {
            "value": 12
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#444444"
          }
        }
      }
    },

    {
      "type": "text",

      "encode": {
        "enter": {
          "x": {
            "signal": "width - 135"
          },

          "y": {
            "value": 17
          },

          "text": {
            "value": "BEE FAMILY"
          },

          "align": {
            "value": "center"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {
            "value": 12
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#444444"
          }
        }
      }
    }
  ],

  "config": {
    "title": {
      "font": "Inter",
      "subtitleFont": "Inter"
    },

    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },

    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },

    "text": {
      "font": "Inter"
    }
  }
}
