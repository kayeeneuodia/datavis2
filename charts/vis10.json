{
  "$schema": "https://vega.github.io/schema/vega/v6.json",

  "width": 820,
  "height": 360,

  "padding": {
    "left": 25,
    "right": 25,
    "top": 38,
    "bottom": 18
  },

  "title": {
    "text": "How Are Bee Records Distributed Across States and Families?",
    "subtitle": "Thicker flows represent more ALA bee occurrence records",
    "anchor": "start",
    "font": "Inter",
    "subtitleFont": "Inter",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "signals": [
    {
      "name": "hoverKey",
      "value": null,
      "on": [
        {
          "events": "@flowLinks:mouseover",
          "update": "datum.stateProvince + '|' + datum.family"
        },
        {
          "events": "@flowLinks:mouseout",
          "update": "null"
        }
      ]
    }
  ],

  "data": [
    {
      "name": "raw",

      "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_state_family_summary.csv",

      "format": {
        "type": "csv",

        "parse": {
          "records": "number",
          "uniqueSpecies": "number"
        }
      }
    },

    {
      "name": "states",

      "source": "raw",

      "transform": [
        {
          "type": "aggregate",

          "groupby": [
            "stateProvince"
          ],

          "fields": [
            "records"
          ],

          "ops": [
            "sum"
          ],

          "as": [
            "total"
          ]
        },

        {
          "type": "collect",

          "sort": {
            "field": "total",
            "order": "descending"
          }
        },

        {
          "type": "window",

          "ops": [
            "row_number"
          ],

          "as": [
            "index"
          ]
        },

        {
          "type": "formula",
          "expr": "50 + (datum.index - 1) * 38",
          "as": "y"
        }
      ]
    },

    {
      "name": "families",

      "source": "raw",

      "transform": [
        {
          "type": "aggregate",

          "groupby": [
            "family"
          ],

          "fields": [
            "records"
          ],

          "ops": [
            "sum"
          ],

          "as": [
            "total"
          ]
        },

        {
          "type": "collect",

          "sort": {
            "field": "total",
            "order": "descending"
          }
        },

        {
          "type": "window",

          "ops": [
            "row_number"
          ],

          "as": [
            "index"
          ]
        },

        {
          "type": "formula",
          "expr": "78 + (datum.index - 1) * 55",
          "as": "y"
        }
      ]
    },

    {
      "name": "links",

      "source": "raw",

      "transform": [
        {
          "type": "lookup",

          "from": "states",

          "key": "stateProvince",

          "fields": [
            "stateProvince"
          ],

          "values": [
            "y"
          ],

          "as": [
            "sourceY"
          ]
        },

        {
          "type": "lookup",

          "from": "families",

          "key": "family",

          "fields": [
            "family"
          ],

          "values": [
            "y"
          ],

          "as": [
            "targetY"
          ]
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "linkWidth",

      "type": "sqrt",

      "domain": {
        "data": "links",
        "field": "records"
      },

      "range": [
        1.3,
        20
      ]
    },

    {
      "name": "familyColor",

      "type": "ordinal",

      "domain": [
        "Apidae",
        "Colletidae",
        "Halictidae",
        "Megachilidae",
        "Stenotritidae"
      ],

      "range": [
        "#32689A",
        "#E67E22",
        "#D94F4F",
        "#49A6A0",
        "#4F8B45"
      ]
    }
  ],

  "marks": [
    {
      "name": "flowLinks",

      "type": "path",

      "from": {
        "data": "links"
      },

      "encode": {
        "enter": {
          "path": {
            "signal": "'M195,' + datum.sourceY + ' C' + (195 + (width - 330) * 0.38) + ',' + datum.sourceY + ' ' + (195 + (width - 330) * 0.62) + ',' + datum.targetY + ' ' + (width - 135) + ',' + datum.targetY"
          },

          "fill": {
            "value": null
          },

          "stroke": {
            "scale": "familyColor",
            "field": "family"
          },

          "cursor": {
            "value": "pointer"
          },

          "tooltip": {
            "signal": "{'State / Territory': datum.stateProvince, 'Bee family': datum.family, 'Occurrence records': format(datum.records, ','), 'Unique recorded taxa': format(datum.uniqueSpecies, ',')}"
          }
        },

        "update": {
          "strokeOpacity": {
            "signal": "hoverKey === null ? 0.24 : (hoverKey === datum.stateProvince + '|' + datum.family ? 0.92 : 0.045)"
          },

          "strokeWidth": {
            "signal": "scale('linkWidth', datum.records) * (hoverKey === datum.stateProvince + '|' + datum.family ? 1.12 : 1)"
          }
        }
      }
    },

    {
      "type": "symbol",

      "from": {
        "data": "states"
      },

      "encode": {
        "enter": {
          "x": {
            "value": 195
          },

          "y": {
            "field": "y"
          },

          "shape": {
            "value": "square"
          },

          "size": {
            "value": 230
          },

          "fill": {
            "value": "#555555"
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "states"
      },

      "encode": {
        "enter": {
          "x": {
            "value": 178
          },

          "y": {
            "field": "y"
          },

          "text": {
            "field": "stateProvince"
          },

          "align": {
            "value": "right"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {
            "value": 13
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#333333"
          }
        }
      }
    },

    {
      "type": "symbol",

      "from": {
        "data": "families"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "width - 135"
          },

          "y": {
            "field": "y"
          },

          "shape": {
            "value": "square"
          },

          "size": {
            "value": 230
          },

          "fill": {
            "scale": "familyColor",
            "field": "family"
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "families"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "width - 117"
          },

          "y": {
            "field": "y"
          },

          "text": {
            "field": "family"
          },

          "align": {
            "value": "left"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {
            "value": 13
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#333333"
          }
        }
      }
    },

    {
      "type": "text",

      "encode": {
        "enter": {
          "x": {
            "value": 195
          },

          "y": {
            "value": 17
          },

          "text": {
            "value": "STATE / TERRITORY"
          },

          "align": {
            "value": "center"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {
            "value": 13
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#4A4338"
          }
        }
      }
    },

    {
      "type": "text",

      "encode": {
        "enter": {
          "x": {
            "signal": "width - 135"
          },

          "y": {
            "value": 17
          },

          "text": {
            "value": "BEE FAMILY"
          },

          "align": {
            "value": "center"
          },

          "font": {
            "value": "Inter"
          },

          "fontSize": {
            "value": 13
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#4A4338"
          }
        }
      }
    }
  ],

  "config": {
    "title": {
      "font": "Inter",
      "subtitleFont": "Inter"
    },

    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },

    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },

    "text": {
      "font": "Inter"
    }
  }
}
