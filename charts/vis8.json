{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Does Greater Bee Diversity Mean More Managed Hives?",
    "subtitle": "Bubble size represents total registered beekeepers in each state",
    "anchor": "start",
    "font": "Inter",
    "subtitleFont": "Inter",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 800,
  "height": 430,

  "data": {
    "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_state_comparison_ALA_DAFF.csv",

    "format": {
      "type": "csv",

      "parse": {
        "alaUniqueTaxa": "number",
        "totalBeekeepers": "number",
        "hives": "number",
        "hivesPerBeekeeper": "number"
      }
    }
  },

  "layer": [

    {
      "params": [
        {
          "name": "stateSelect",

          "select": {
            "type": "point",
            "fields": [
              "state"
            ]
          },

          "bind": "legend"
        }
      ],

      "mark": {
        "type": "circle",
        "stroke": "white",
        "strokeWidth": 1.5,
        "cursor": "pointer"
      },

      "encoding": {

        "x": {
          "field": "alaUniqueTaxa",
          "type": "quantitative",
          "title": "Unique recorded bee taxa (ALA)",

          "scale": {
            "zero": false,
            "domain": [
              100,
              700
            ]
          },

          "axis": {
            "values": [
              100,
              200,
              300,
              400,
              500,
              600,
              700
            ],

            "grid": true,
            "labelFontSize": 12,
            "titleFontSize": 12
          }
        },

        "y": {
          "field": "hives",
          "type": "quantitative",
          "title": "Managed hives (DAFF)",

          "scale": {
            "domain": [
              0,
              325000
            ]
          },

          "axis": {
            "values": [
              0,
              50000,
              100000,
              150000,
              200000,
              250000,
              300000
            ],

            "labelExpr": "format(datum.value, ',')",

            "grid": true,
            "labelFontSize": 12,
            "titleFontSize": 12
          }
        },

        "size": {
          "field": "totalBeekeepers",
          "type": "quantitative",
          "title": "Total beekeepers",

          "scale": {
            "range": [
              220,
              1900
            ]
          },

          "legend": {
            "orient": "right",

            "values": [
              2000,
              4000,
              6000,
              8000
            ],

            "labelFontSize": 11,
            "titleFontSize": 11,
            "symbolOpacity": 0.75
          }
        },

        "color": {
          "field": "state",
          "type": "nominal",
          "title": "State",

          "legend": {
            "orient": "right",
            "labelFontSize": 11,
            "titleFontSize": 11,
            "symbolSize": 90
          }
        },

        "opacity": {
          "condition": {
            "param": "stateSelect",
            "value": 0.9
          },

          "value": 0.12
        },

        "tooltip": [

          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },

          {
            "field": "alaUniqueTaxa",
            "type": "quantitative",
            "title": "Unique recorded bee taxa",
            "format": ","
          },

          {
            "field": "hives",
            "type": "quantitative",
            "title": "Managed hives",
            "format": ","
          },

          {
            "field": "totalBeekeepers",
            "type": "quantitative",
            "title": "Registered beekeepers",
            "format": ","
          },

          {
            "field": "hivesPerBeekeeper",
            "type": "quantitative",
            "title": "Hives per beekeeper",
            "format": ".1f"
          }

        ]

      }

    },


    {
      "transform": [
        {
          "filter": "datum.state === 'New South Wales'"
        }
      ],

      "mark": {
        "type": "point",
        "filled": false,
        "size": 2400,
        "stroke": "#D6A51E",
        "strokeWidth": 3
      },

      "encoding": {

        "x": {
          "field": "alaUniqueTaxa",
          "type": "quantitative",

          "scale": {
            "domain": [
              100,
              700
            ]
          }
        },

        "y": {
          "field": "hives",
          "type": "quantitative",

          "scale": {
            "domain": [
              0,
              325000
            ]
          }
        }

      }

    },


    {
      "transform": [
        {
          "filter": "datum.state === 'New South Wales'"
        }
      ],

      "mark": {
        "type": "text",
        "dy": -31,
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#5A4526"
      },

      "encoding": {

        "x": {
          "field": "alaUniqueTaxa",
          "type": "quantitative",

          "scale": {
            "domain": [
              100,
              700
            ]
          }
        },

        "y": {
          "field": "hives",
          "type": "quantitative",

          "scale": {
            "domain": [
              0,
              325000
            ]
          }
        },

        "text": {
          "value": "Most managed hives"
        }

      }

    },


    {
      "transform": [
        {
          "filter": "datum.state === 'New South Wales'"
        }
      ],

      "mark": {
        "type": "text",
        "dy": -14,
        "font": "Inter",
        "fontSize": 11,
        "color": "#5A4526"
      },

      "encoding": {

        "x": {
          "field": "alaUniqueTaxa",
          "type": "quantitative",

          "scale": {
            "domain": [
              100,
              700
            ]
          }
        },

        "y": {
          "field": "hives",
          "type": "quantitative",

          "scale": {
            "domain": [
              0,
              325000
            ]
          }
        },

        "text": {
          "value": "297,362 hives"
        }

      }

    }

  ],

  "config": {

    "view": {
      "stroke": null
    },

    "title": {
      "font": "Inter",
      "subtitleFont": "Inter"
    },

    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 12
    },

    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },

    "text": {
      "font": "Inter"
    }

  }

}
