{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Does Greater Bee Diversity Mean More Managed Hives?",
    "subtitle": "Bubble size represents total registered beekeepers in each state",
    "anchor": "start",
    "font": "Inter",
    "subtitleFont": "Inter",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 800,
  "height": 430,

  "data": {
    "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_state_comparison_ALA_DAFF.csv",
    "format": {
      "type": "csv",
      "parse": {
        "alaUniqueTaxa": "number",
        "totalBeekeepers": "number",
        "hives": "number",
        "hivesPerBeekeeper": "number"
      }
    }
  },

  "encoding": {
    "x": {
      "field": "alaUniqueTaxa",
      "type": "quantitative",
      "title": "Unique recorded bee taxa (ALA)",
      "scale": {
        "zero": false,
        "domain": [
          100,
          700
        ]
      },
      "axis": {
        "values": [
          100,
          200,
          300,
          400,
          500,
          600,
          700
        ],
        "labelFont": "Inter",
        "titleFont": "Inter"
      }
    },

    "y": {
      "field": "hives",
      "type": "quantitative",
      "title": "Managed hives (DAFF)",
      "scale": {
        "domain": [
          0,
          325000
        ]
      },
      "axis": {
        "values": [
          0,
          50000,
          100000,
          150000,
          200000,
          250000,
          300000
        ],
        "format": ",",
        "labelFont": "Inter",
        "titleFont": "Inter"
      }
    }
  },

  "layer": [
    {
      "params": [
        {
          "name": "stateSelect",
          "select": {
            "type": "point",
            "fields": [
              "state"
            ]
          },
          "bind": "legend"
        }
      ],

      "mark": {
        "type": "circle",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },

      "encoding": {
        "size": {
          "field": "totalBeekeepers",
          "type": "quantitative",
          "title": "Total beekeepers",
          "scale": {
            "range": [
              200,
              1800
            ]
          },
          "legend": {
            "orient": "right",
            "titleFont": "Inter",
            "labelFont": "Inter",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "values": [
              2000,
              4000,
              6000,
              8000
            ]
          }
        },

        "color": {
          "field": "state",
          "type": "nominal",
          "title": "State",
          "scale": {
            "domain": [
              "New South Wales",
              "Queensland",
              "South Australia",
              "Tasmania",
              "Victoria",
              "Western Australia"
            ],
            "range": [
              "#4E79A7",
              "#F28E2B",
              "#E15759",
              "#76B7B2",
              "#59A14F",
              "#EDC948"
            ]
          },
          "legend": {
            "orient": "right",
            "titleFont": "Inter",
            "labelFont": "Inter",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },

        "opacity": {
          "condition": {
            "param": "stateSelect",
            "value": 0.9
          },
          "value": 0.12
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "alaUniqueTaxa",
            "type": "quantitative",
            "title": "Unique recorded bee taxa",
            "format": ","
          },
          {
            "field": "hives",
            "type": "quantitative",
            "title": "Managed hives",
            "format": ","
          },
          {
            "field": "totalBeekeepers",
            "type": "quantitative",
            "title": "Registered beekeepers",
            "format": ","
          },
          {
            "field": "hivesPerBeekeeper",
            "type": "quantitative",
            "title": "Hives per beekeeper",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.state === 'New South Wales'"
        }
      ],

      "mark": {
        "type": "point",
        "filled": false,
        "size": 2300,
        "stroke": "#D6A51E",
        "strokeWidth": 3
      }
    },

    {
      "transform": [
        {
          "filter": "datum.state === 'New South Wales'"
        },
        {
          "calculate": "'Most managed hives'",
          "as": "annotation"
        }
      ],

      "mark": {
        "type": "text",
        "dy": -32,
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#5A4526"
      },

      "encoding": {
        "text": {
          "field": "annotation",
          "type": "nominal"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.state === 'New South Wales'"
        },
        {
          "calculate": "'297,362 hives'",
          "as": "annotation"
        }
      ],

      "mark": {
        "type": "text",
        "dy": -16,
        "font": "Inter",
        "fontSize": 11,
        "color": "#5A4526"
      },

      "encoding": {
        "text": {
          "field": "annotation",
          "type": "nominal"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.state === 'Queensland'"
        }
      ],

      "mark": {
        "type": "point",
        "filled": false,
        "size": 2300,
        "stroke": "#D6A51E",
        "strokeWidth": 3
      }
    },

    {
      "transform": [
        {
          "filter": "datum.state === 'Queensland'"
        },
        {
          "calculate": "'Highest recorded diversity'",
          "as": "annotation"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "dx": -16,
        "dy": -13,
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#5A4526"
      },

      "encoding": {
        "text": {
          "field": "annotation",
          "type": "nominal"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.state === 'Queensland'"
        },
        {
          "calculate": "'651 taxa'",
          "as": "annotation"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "dx": -16,
        "dy": 3,
        "font": "Inter",
        "fontSize": 11,
        "color": "#5A4526"
      },

      "encoding": {
        "text": {
          "field": "annotation",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "title": {
      "font": "Inter",
      "subtitleFont": "Inter"
    },

    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "gridColor": "#E5E5E5"
    },

    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },

    "text": {
      "font": "Inter"
    }
  }
}
