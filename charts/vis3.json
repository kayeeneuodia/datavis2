{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Where Are Bee Records Concentrated?",
    "subtitle": "Larger and darker circles show areas with more recorded bee occurrences",
    "anchor": "start",
    "font": "Inter",
    "subtitleFont": "Inter",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 800,
  "height": 520,

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",

        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#F0EDE5",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_grid_summary.csv",

        "format": {
          "type": "csv",

          "parse": {
            "latitudeCenter": "number",
            "longitudeCenter": "number",
            "records": "number",
            "uniqueSpecies": "number"
          }
        }
      },

      "transform": [
        {
          "filter": "isValid(datum.latitudeCenter) && isValid(datum.longitudeCenter) && datum.records > 0"
        },
        {
          "calculate": "datum.records",
          "as": "recordsForSize"
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.72,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      },

      "encoding": {
        "longitude": {
          "field": "longitudeCenter",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitudeCenter",
          "type": "quantitative"
        },

        "size": {
          "field": "recordsForSize",
          "type": "quantitative",
          "title": "Occurrence records",

          "scale": {
            "type": "sqrt",
            "range": [
              20,
              1800
            ]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Occurrence records",
            "values": [
              100,
              1000,
              3000,
              6000
            ],
            "titleFont": "Inter",
            "labelFont": "Inter",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "symbolFillColor": "#E67E22",
            "symbolStrokeColor": "#FFFFFF"
          }
        },

        "color": {
          "field": "records",
          "type": "quantitative",
          "legend": null,

          "scale": {
            "scheme": "yelloworangered"
          }
        },

        "tooltip": [
          {
            "field": "records",
            "type": "quantitative",
            "title": "Occurrence records",
            "format": ","
          },
          {
            "field": "uniqueSpecies",
            "type": "quantitative",
            "title": "Unique recorded taxa",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "title": {
      "font": "Inter",
      "subtitleFont": "Inter"
    },

    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },

    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },

    "text": {
      "font": "Inter"
    }
  }
}
