{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Where Are Bee Records Concentrated?",
    "subtitle": "Larger and darker circles represent areas with more recorded bee occurrences",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 760,
  "height": 500,

  "projection": {
    "type": "equalEarth"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d9d9d9",
        "stroke": "white",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_hotspot_grid.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number",
            "records": "number"
          }
        }
      },

      "mark": {
        "type": "circle",
        "opacity": 0.65,
        "stroke": "white",
        "strokeWidth": 0.25
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "records",
          "type": "quantitative",
          "title": "Occurrence records",
          "scale": {
            "range": [12, 1500]
          },
          "legend": {
            "orient": "right",
            "labelFontSize": 12,
            "titleFontSize": 12,
            "format": ","
          }
        },

        "color": {
          "field": "records",
          "type": "quantitative",
          "title": "Occurrence records",
          "scale": {
            "scheme": "orangered"
          },
          "legend": null
        },

        "tooltip": [
          {
            "field": "records",
            "type": "quantitative",
            "title": "Occurrence records",
            "format": ","
          },
          {
            "field": "longitude",
            "type": "quantitative",
            "title": "Longitude",
            "format": ".2f"
          },
          {
            "field": "latitude",
            "type": "quantitative",
            "title": "Latitude",
            "format": ".2f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}
