{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Where Are Bee Records Concentrated?",
    "subtitle": "Larger and darker circles represent areas with more recorded bee occurrences",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 700,
  "height": 500,

  "projection": {
    "type": "equalEarth"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#d9d9d9",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_grid_summary.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitudeCenter": "number",
            "latitudeCenter": "number",
            "records": "number",
            "uniqueSpecies": "number"
          }
        }
      },

      "mark": {
        "type": "circle",
        "opacity": 0.65
      },

      "encoding": {
        "longitude": {
          "field": "longitudeCenter",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitudeCenter",
          "type": "quantitative"
        },

        "size": {
          "field": "records",
          "type": "quantitative",
          "title": "Occurrence records",
          "scale": {
            "range": [20, 800]
          }
        },

        "color": {
          "field": "records",
          "type": "quantitative",
          "title": "Occurrence records",
          "scale": {
            "scheme": "orangered"
          }
        },

        "tooltip": [
          {
            "field": "records",
            "type": "quantitative",
            "title": "Occurrence records",
            "format": ","
          },
          {
            "field": "uniqueSpecies",
            "type": "quantitative",
            "title": "Unique recorded taxa",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
