{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Where Are Bee Records Concentrated?",
    "subtitle": "Larger and darker circles show areas with more recorded bee occurrences",
    "anchor": "start",
    "font": "Inter",
    "subtitleFont": "Inter",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "spacing": 4,

  "vconcat": [
    {
      "width": 800,
      "height": 470,

      "projection": {
        "type": "mercator"
      },

      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",

            "format": {
              "type": "json",
              "property": "features"
            }
          },

          "mark": {
            "type": "geoshape",
            "fill": "#F0EDE5",
            "stroke": "#FFFFFF",
            "strokeWidth": 1.2
          }
        },

        {
          "data": {
            "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_grid_summary.csv",

            "format": {
              "type": "csv",

              "parse": {
                "latitudeCenter": "number",
                "longitudeCenter": "number",
                "records": "number",
                "uniqueSpecies": "number"
              }
            }
          },

          "transform": [
            {
              "filter": "isValid(datum.latitudeCenter) && isValid(datum.longitudeCenter) && datum.records > 0"
            }
          ],

          "mark": {
            "type": "circle",
            "opacity": 0.78,
            "stroke": "#FFFFFF",
            "strokeWidth": 0.5
          },

          "encoding": {
            "longitude": {
              "field": "longitudeCenter",
              "type": "quantitative"
            },

            "latitude": {
              "field": "latitudeCenter",
              "type": "quantitative"
            },

            "size": {
              "field": "records",
              "type": "quantitative",

              "scale": {
                "type": "sqrt",
                "domain": [
                  0,
                  6000
                ],
                "range": [
                  20,
                  1800
                ]
              },

              "legend": null
            },

            "color": {
              "field": "records",
              "type": "quantitative",

              "scale": {
                "scheme": "yelloworangered",
                "domain": [
                  0,
                  6000
                ]
              },

              "legend": null
            },

            "tooltip": [
              {
                "field": "records",
                "type": "quantitative",
                "title": "Occurrence records",
                "format": ","
              },

              {
                "field": "uniqueSpecies",
                "type": "quantitative",
                "title": "Unique recorded taxa",
                "format": ","
              }
            ]
          }
        }
      ]
    },

    {
      "width": 800,
      "height": 78,

      "layer": [
        {
          "data": {
            "values": [
              {
                "label": "legend"
              }
            ]
          },

          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "font": "Inter",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#29271F"
          },

          "encoding": {
            "x": {
              "value": 0
            },

            "y": {
              "value": 2
            },

            "text": {
              "value": "Occurrence records"
            }
          }
        },

        {
          "data": {
            "values": [
              {
                "records": 100
              },
              {
                "records": 1000
              },
              {
                "records": 3000
              },
              {
                "records": 6000
              }
            ]
          },

          "mark": {
            "type": "circle",
            "opacity": 0.85,
            "stroke": "#FFFFFF",
            "strokeWidth": 0.7
          },

          "encoding": {
            "x": {
              "field": "records",
              "type": "ordinal",

              "sort": [
                100,
                1000,
                3000,
                6000
              ],

              "scale": {
                "paddingOuter": 0.55
              },

              "axis": null
            },

            "y": {
              "value": 40
            },

            "size": {
              "field": "records",
              "type": "quantitative",

              "scale": {
                "type": "sqrt",
                "domain": [
                  100,
                  6000
                ],
                "range": [
                  100,
                  1100
                ]
              },

              "legend": null
            },

            "color": {
              "field": "records",
              "type": "quantitative",

              "scale": {
                "scheme": "yelloworangered",
                "domain": [
                  100,
                  6000
                ]
              },

              "legend": null
            }
          }
        },

        {
          "data": {
            "values": [
              {
                "records": 100
              },
              {
                "records": 1000
              },
              {
                "records": 3000
              },
              {
                "records": 6000
              }
            ]
          },

          "mark": {
            "type": "text",
            "baseline": "top",
            "font": "Inter",
            "fontSize": 11,
            "color": "#29271F",
            "dy": 26
          },

          "encoding": {
            "x": {
              "field": "records",
              "type": "ordinal",

              "sort": [
                100,
                1000,
                3000,
                6000
              ],

              "scale": {
                "paddingOuter": 0.55
              },

              "axis": null
            },

            "y": {
              "value": 40
            },

            "text": {
              "field": "records",
              "type": "quantitative",
              "format": ","
            }
          }
        }
      ]
    }
  ],

  "resolve": {
    "scale": {
      "color": "independent",
      "size": "independent"
    }
  },

  "config": {
    "view": {
      "stroke": null
    },

    "title": {
      "font": "Inter",
      "subtitleFont": "Inter"
    },

    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },

    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },

    "text": {
      "font": "Inter"
    }
  }
}
