{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Recorded Bee Diversity Across Australia",
    "subtitle": "Unique bee taxa recorded in each state and territory",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 700,
  "height": 500,

  "data": {
    "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "values": [
            {"state": "New South Wales", "uniqueTaxa": 452},
            {"state": "Victoria", "uniqueTaxa": 452},
            {"state": "Queensland", "uniqueTaxa": 651},
            {"state": "South Australia", "uniqueTaxa": 281},
            {"state": "Western Australia", "uniqueTaxa": 466},
            {"state": "Tasmania", "uniqueTaxa": 145},
            {"state": "Northern Territory", "uniqueTaxa": 276},
            {"state": "Australian Capital Territory", "uniqueTaxa": 193}
          ]
        },
        "key": "state",
        "fields": ["uniqueTaxa"]
      }
    }
  ],

  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },

  "encoding": {
    "color": {
      "field": "uniqueTaxa",
      "type": "quantitative",
      "title": "Unique recorded bee taxa",
      "scale": {
        "scheme": "yellowgreenblue"
      }
    },

    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State / Territory"
      },
      {
        "field": "uniqueTaxa",
        "type": "quantitative",
        "title": "Unique bee taxa",
        "format": ","
      }
    ]
  },

  "projection": {
    "type": "equalEarth"
  },

  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
