{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Recorded Bee Diversity Relative to Recording Effort",
    "subtitle": "Unique recorded bee taxa per 1,000 ALA occurrence records",
    "anchor": "start",
    "font": "Inter",
    "subtitleFont": "Inter",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 700,
  "height": 500,

  "data": {
    "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "values": [
            {
              "state": "New South Wales",
              "uniqueTaxa": 452,
              "records": 18567,
              "taxaPer1000": 24.3
            },
            {
              "state": "Victoria",
              "uniqueTaxa": 452,
              "records": 26261,
              "taxaPer1000": 17.2
            },
            {
              "state": "Queensland",
              "uniqueTaxa": 651,
              "records": 27777,
              "taxaPer1000": 23.4
            },
            {
              "state": "South Australia",
              "uniqueTaxa": 281,
              "records": 14092,
              "taxaPer1000": 19.9
            },
            {
              "state": "Western Australia",
              "uniqueTaxa": 466,
              "records": 13893,
              "taxaPer1000": 33.5
            },
            {
              "state": "Tasmania",
              "uniqueTaxa": 145,
              "records": 4895,
              "taxaPer1000": 29.6
            },
            {
              "state": "Northern Territory",
              "uniqueTaxa": 276,
              "records": 12951,
              "taxaPer1000": 21.3
            },
            {
              "state": "Australian Capital Territory",
              "uniqueTaxa": 193,
              "records": 4844,
              "taxaPer1000": 39.8
            }
          ]
        },
        "key": "state",
        "fields": [
          "uniqueTaxa",
          "records",
          "taxaPer1000"
        ]
      }
    }
  ],

  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.2
  },

  "encoding": {
    "color": {
      "field": "taxaPer1000",
      "type": "quantitative",
      "title": [
        "Unique bee taxa",
        "per 1,000 records"
      ],
      "scale": {
        "scheme": "yellowgreenblue"
      },
      "legend": {
        "format": ".0f",
        "orient": "right",
        "titleFont": "Inter",
        "labelFont": "Inter",
        "titleFontSize": 12,
        "labelFontSize": 12
      }
    },

    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State / Territory"
      },
      {
        "field": "taxaPer1000",
        "type": "quantitative",
        "title": "Taxa per 1,000 records",
        "format": ".1f"
      },
      {
        "field": "uniqueTaxa",
        "type": "quantitative",
        "title": "Unique recorded bee taxa",
        "format": ","
      },
      {
        "field": "records",
        "type": "quantitative",
        "title": "ALA occurrence records",
        "format": ","
      }
    ]
  },

  "projection": {
    "type": "mercator"
  },

  "config": {
    "view": {
      "stroke": null
    },

    "title": {
      "font": "Inter",
      "subtitleFont": "Inter"
    },

    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 12
    },

    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },

    "text": {
      "font": "Inter"
    }
  }
}
