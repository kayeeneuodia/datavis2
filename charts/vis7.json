{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "How Much Does Recording Activity Vary Through the Year?",
    "subtitle": "Boxplots summarise monthly variation; dots show individual months",
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 11,
    "subtitleColor": "#666"
  },

  "width": 430,
  "height": 260,

  "data": {
    "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_month_family_summary.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month": "number",
        "records": "number",
        "uniqueSpecies": "number"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 40
      },
      "encoding": {
        "x": {
          "field": "family",
          "type": "nominal",
          "title": "Bee family",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 10,
            "titleFontSize": 11
          }
        },
        "y": {
          "field": "records",
          "type": "quantitative",
          "title": "Monthly occurrence records",
          "axis": {
            "labelFontSize": 10,
            "titleFontSize": 11,
            "format": ","
          }
        },
        "color": {
          "field": "family",
          "type": "nominal",
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 35,
        "opacity": 0.6
      },
      "encoding": {
        "x": {
          "field": "family",
          "type": "nominal"
        },
        "y": {
          "field": "records",
          "type": "quantitative"
        },
        "color": {
          "field": "family",
          "type": "nominal",
          "legend": null
        },
        "tooltip": [
          {
            "field": "family",
            "type": "nominal",
            "title": "Bee family"
          },
          {
            "field": "monthName",
            "type": "ordinal",
            "title": "Month"
          },
          {
            "field": "records",
            "type": "quantitative",
            "title": "Occurrence records",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}
