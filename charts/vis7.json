{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "width": 400,
  "height": 255,

  "data": {
    "url": "https://raw.githubusercontent.com/kayeeneuodia/datavis2/main/data/bee_month_family_summary.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month": "number",
        "records": "number",
        "uniqueSpecies": "number"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 42
      },

      "encoding": {
        "x": {
          "field": "family",
          "type": "nominal",
          "title": "Bee family",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 10,
            "titleFontSize": 12
          }
        },

        "y": {
          "field": "records",
          "type": "quantitative",
          "title": "Monthly occurrence records",
          "axis": {
            "labelFontSize": 11,
            "titleFontSize": 12,
            "format": ","
          }
        },

        "color": {
          "field": "family",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apidae",
              "Colletidae",
              "Halictidae",
              "Megachilidae",
              "Stenotritidae"
            ],
            "range": [
              "#4E79A7",
              "#F28E2B",
              "#E15759",
              "#76B7B2",
              "#59A14F"
            ]
          }
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 38,
        "opacity": 0.65
      },

      "encoding": {
        "x": {
          "field": "family",
          "type": "nominal"
        },

        "y": {
          "field": "records",
          "type": "quantitative"
        },

        "color": {
          "field": "family",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apidae",
              "Colletidae",
              "Halictidae",
              "Megachilidae",
              "Stenotritidae"
            ],
            "range": [
              "#4E79A7",
              "#F28E2B",
              "#E15759",
              "#76B7B2",
              "#59A14F"
            ]
          }
        },

        "tooltip": [
          {
            "field": "family",
            "type": "nominal",
            "title": "Bee family"
          },
          {
            "field": "monthName",
            "type": "ordinal",
            "title": "Month"
          },
          {
            "field": "records",
            "type": "quantitative",
            "title": "Occurrence records",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}
